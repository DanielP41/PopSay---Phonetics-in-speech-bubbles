# ---- Proveedor de voz neuronal: none | azure | openai | elevenlabs | fake
TTS_PROVIDER=azure

# Azure AI Speech (recomendado: muy buenas voces US/UK y capa gratuita mensual)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_VOICE_US=en-US-JennyNeural
AZURE_VOICE_GB=en-GB-SoniaNeural

# OpenAI (el acento se pide por instrucciones con gpt-4o-mini-tts)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=alloy

# ElevenLabs (elegí una voz americana y una británica en su biblioteca)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_US=
ELEVENLABS_VOICE_GB=

# ---- Infraestructura
# Vacío = caché en memoria. Con docker compose se usa el Redis incluido.
REDIS_URL=
CACHE_TTL_SECONDS=2592000
MEMORY_CACHE_MAX_MB=64

# ---- Seguridad y límites
# Si lo completás, pegá el mismo valor en Ajustes › API key de la extensión.
API_TOKEN=
MAX_TEXT_CHARS=1000
RATE_LIMIT_PER_MINUTE=60
